# Save to /etc/systemd/system/mnq-watchdog.service
# SAFETY CRITICAL: Independent flatten watchdog
# Runs separately from the main bot. If bot crashes, watchdog still flattens at 15:45 ET.
# This is the last line of defense against overnight positions.
[Unit]
Description=MNQ Flatten Watchdog (safety-critical)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/mnq-orb-bot
ExecStart=/opt/mnq-orb-bot/.venv/bin/python -m bot.watchdog
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/mnq-orb-bot/.env

# Watchdog ALWAYS restarts — this process must never stay down
StartLimitBurst=0

[Install]
WantedBy=multi-user.target
